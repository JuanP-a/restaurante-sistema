# "pglite" (desktop, DB embebida sin servidor) o "postgres" (SaaS/cloud).
# En pglite, DATABASE_URL no se usa; DB_PATH apunta al directorio de datos.
DB_DRIVER=postgres
DB_PATH=./.data/pglite
MIGRATIONS_PATH=./drizzle
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurante
# Dev hash of "admin1234" (bcrypt cost 10). Replace for prod via `pnpm hash:password`.
# IMPORTANT: escape every `$` as `\$` — Next.js expands `$VAR` in .env values,
# which silently truncates the bcrypt hash. Without escapes the dev login fails.
ADMIN_PASSWORD_HASH="\$2b\$10\$YoEEXhwQhn5gKntCyJDQZ.aNl60oRDzKiRtoLGM6JUkuPXKrUCSSG"
SESSION_SECRET=
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_URL=https://waba-v2.360dialog.io
WHATSAPP_VERIFY_TOKEN=
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
# Exposed to the browser by the bill print template — leave blank
# if the business header should fall back to "Mi Restaurante".
NEXT_PUBLIC_BUSINESS_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_BUSINESS_PHONE=
DEFAULT_PREP_TIME_MINUTES=25

# Impresora térmica de red (desktop). Vacío = imprimir desde el navegador.
PRINTER_HOST=
PRINTER_PORT=9100

# Backups (versión desktop)
BACKUP_DIR=./.data/backups          # carpeta sincronizada (Drive/OneDrive/Dropbox)
BACKUP_KEEP=7                       # backups a retener por destino