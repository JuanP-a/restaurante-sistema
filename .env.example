DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurante
# Dev hash of "admin1234" (bcrypt cost 10). Replace for prod via `pnpm hash:password`.
# IMPORTANT: escape every `$` as `\$` — Next.js expands `$VAR` in .env values,
# which silently truncates the bcrypt hash. Without escapes the dev login fails.
ADMIN_PASSWORD_HASH="\$2b\$10\$YoEEXhwQhn5gKntCyJDQZ.aNl60oRDzKiRtoLGM6JUkuPXKrUCSSG"
SESSION_SECRET=
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_URL=https://waba-v2.360dialog.io
WHATSAPP_VERIFY_TOKEN=
BUSINESS_NAME=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
DEFAULT_PREP_TIME_MINUTES=25