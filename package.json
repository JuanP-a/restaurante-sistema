{
  "name": "restaurante-sistema",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run --passWithNoTests --no-file-parallelism",
    "test:unit": "vitest run --passWithNoTests --no-file-parallelism --exclude 'tests/integration/**'",
    "test:integration": "vitest run --passWithNoTests --no-file-parallelism tests/integration",
    "test:watch": "vitest --no-file-parallelism",
    "test:coverage": "vitest run --coverage --passWithNoTests --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "hash:password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "dotenv": "^18.0.0",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@10.34.5"
}
