{
  "name": "restaurante-sistema",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "cross-env VITEST_INIT_DB=1 vitest run --passWithNoTests --no-file-parallelism",
    "test:unit": "vitest run --passWithNoTests --no-file-parallelism --exclude 'tests/integration/**'",
    "test:integration": "cross-env VITEST_INIT_DB=1 vitest run --passWithNoTests --no-file-parallelism tests/integration",
    "test:watch": "cross-env VITEST_INIT_DB=1 vitest --no-file-parallelism",
    "test:coverage": "cross-env VITEST_INIT_DB=1 vitest run --coverage --passWithNoTests --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "hash:password": "node scripts/hash-password.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-tools": "^0.4.8",
    "bcryptjs": "^3.0.3",
    "drivelist": "^12.0.2",
    "drizzle-orm": "^0.45.3",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.5",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "source-map-js@<1.2.2": "1.2.2",
      "sharp@<0.35.5": "0.35.5",
      "vite@<8.3.3": "8.3.5"
    }
  }
}
